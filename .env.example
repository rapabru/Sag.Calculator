# Login con Google e historial sincronizado. Opcional: sin estas variables la app
# funciona igual, el botón de login no aparece y el historial vive en el navegador.
#
# Copiá este archivo a .env.local y completá con los datos de tu proyecto de
# Supabase (Project Settings -> API). La clave anon es pública por diseño: la
# seguridad la da Row Level Security en la base, no el secreto de la clave.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
