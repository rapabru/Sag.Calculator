{
  "name": "slackline-sag-calculator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run test:physics && npm run test:smoke && npm run test:locales",
    "test:physics": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "test:locales": "node scripts/check-locales.mjs",
    "test:smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke.cjs --log-level=warning --jsx=automatic && node node_modules/.cache/smoke.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
